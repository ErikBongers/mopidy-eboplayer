{
    //  "include": ["mopidy_eboplayer/www/typescript/**/*"],
    "files": [
      "main.ts"
    ],
    "include": [
        "./**/*"
    ],
    "exclude": [],
    "compilerOptions": {
        "outDir": ".",
        "target": "esnext",
        "sourceMap": true,
        "noEmit": true,
        "incremental": false,
        "moduleResolution": "bundler",
        "noImplicitOverride": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "strict": true,
        "paths": {
        },
        "typeRoots": ["node_modules/@types"],
        "types": ["node"]
    },
}